# 复制成 .env.local 再填。.env.local 已被 .gitignore 忽略，不要提交真实值。

# 仿真用户与评审各自一把。默认评审走 OpenAI，仿真用户走 Anthropic。
# 把 config/judge.json 与 config/fake-user.json 的 connectionSutId 改成同一条，也可以共用一家。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 本地跑权限 / 配额用例（可选）─────────────────────────────────────
# 这些用例需要 MySQL；不填就自动跳过（CI 里由 mysql 服务提供）。
# 自己的库与超管密码等平台配置在 config/platform.json（模板见 config/platform.example.json）。
# SIM_EVAL_TEST_MYSQL_HOST=127.0.0.1
# SIM_EVAL_TEST_MYSQL_PORT=3306
# SIM_EVAL_TEST_MYSQL_USER=root
# SIM_EVAL_TEST_MYSQL_PASSWORD=
