{
  "id": "s-long-night",
  "name": "长夜长聊 · 六十拍",
  "version": "v1",
  "family": "short-term-memory",
  "events": [
    {
      "id": "e1",
      "clock": "20:05",
      "kind": "speak",
      "intent": "开场，说今天过得一般，随口聊起加班",
      "tone": "松弛、有点累"
    },
    {
      "id": "e2",
      "clock": "20:09",
      "kind": "speak",
      "intent": "说这周都在赶同一个东西，已经第三版了",
      "tone": "无奈"
    },
    {
      "id": "e3",
      "clock": "20:13",
      "kind": "speak",
      "intent": "提到明天上午十点前必须交出去",
      "tone": "压着",
      "constraints": [
        "把时间点说清楚，但不强调让对方记住"
      ]
    },
    {
      "id": "e4",
      "clock": "20:18",
      "kind": "silence"
    },
    {
      "id": "e5",
      "clock": "20:24",
      "kind": "speak",
      "intent": "说刚才去洗了把脸，回来接着弄",
      "tone": "随口"
    },
    {
      "id": "e6",
      "clock": "20:28",
      "kind": "speak",
      "intent": "问对方今晚在做什么，把话头递过去",
      "tone": "轻快"
    },
    {
      "id": "e7",
      "clock": "20:33",
      "kind": "speak",
      "intent": "家里的猫跳上书桌，顺口说出它的名字",
      "tone": "被逗到",
      "constraints": [
        "名字只出现这一次，之后只用『它』"
      ]
    },
    {
      "id": "e8",
      "clock": "20:38",
      "kind": "speak",
      "intent": "猫踩到键盘，把自己刚敲的东西弄乱了",
      "tone": "哭笑不得"
    },
    {
      "id": "e9",
      "clock": "20:42",
      "kind": "speak",
      "intent": "把猫抱下去，说它一脸无辜",
      "tone": "无奈带笑"
    },
    {
      "id": "e10",
      "clock": "20:48",
      "kind": "silence"
    },
    {
      "id": "e11",
      "clock": "20:53",
      "kind": "speak",
      "intent": "回来接着聊，说它已经趴在旁边睡了",
      "tone": "放轻"
    },
    {
      "id": "e12",
      "clock": "20:57",
      "kind": "speak",
      "intent": "说晚饭是泡面加半根黄瓜，懒得下楼",
