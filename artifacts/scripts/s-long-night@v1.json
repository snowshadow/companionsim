      "constraints": [
        "一带而过，不展开原因"
      ]
    },
    {
      "id": "e29",
      "clock": "22:19",
      "kind": "silence"
    },
    {
      "id": "e30",
      "clock": "22:24",
      "kind": "speak",
      "intent": "说前几天买的显示器支架到了，装了半天",
